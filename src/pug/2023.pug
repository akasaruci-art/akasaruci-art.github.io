extends layouts/main.pug

block content
    section.gallery-section
        #canvas
            .container.px-4.px-lg-5

                // Three-column gallery
                .row.gx-0.mb-5.mb-lg-0.justify-content-center
                    +gallery-item('assets/gallery/2023/01.jpg', 'Maroon Eventide', '20cm x 20cm', 3)
                    +gallery-item('assets/gallery/2023/02.jpg', 'The Paps at Dusk', '20cm x 20cm', 3, true)
                    +gallery-item('assets/gallery/2023/03.jpg', 'Dark Sound', '20cm x 20cm', 3)
                    +gallery-item('assets/gallery/2023/04.jpg', 'Jade Hill', '20cm x 20cm', 3)
                    +gallery-item('assets/gallery/2023/05.jpg', 'Dark Red Night', '20cm x 20cm', 3)
                    +gallery-item('assets/gallery/2023/06.jpg', 'Purple Headed Mountain', '20cm x 20cm', 3)

                // Two-column gallery
                .row.gx-0.mb-5.mb-lg-0.justify-content-center
                    +gallery-item('assets/gallery/2023/07.jpg', 'Inky Blue Light', '36cm x 46cm', 2)
                    +gallery-item('assets/gallery/2023/08.jpg', 'Light Disappearing Over the Horizon', '36cm x 46cm', 2)
                    +gallery-item('assets/gallery/2023/09.jpg', 'Outline of the Climb', '36cm x 46cm', 2)
                    +gallery-item('assets/gallery/2023/10.jpg', 'Dark Moorland', '36cm x 46cm', 2)
                    +gallery-item('assets/gallery/2023/11.jpg', 'The Distance', '36cm x 46cm', 2)
                    +gallery-item('assets/gallery/2023/12.jpg', 'Turquoise Dusk', '36cm x 46cm', 2)

                // Full-width gallery
                .row.gx-0.mb-5.mb-lg-0.justify-content-center
                    +gallery-item('assets/gallery/2023/13.jpg', 'Slumbering Sky', '50cm x 100cm', 1)
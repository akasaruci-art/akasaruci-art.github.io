include mixins/navbar.pug

doctype html
html(lang='en')

    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title Jules Jackson

        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Font Awesome icons
        script(src='https://use.fontawesome.com/releases/v5.15.4/js/all.js', crossorigin='anonymous')

        // Google fonts
        link(href='https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i', rel='stylesheet')
        link(href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet")

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body#page-top

        +navbar()
        
        // Contact
        section.contact-section.extra-about-padding.grey-background.text-center
            .inner-section
                .container.px-4.px-lg-5
                    .row.gx-4.gx-lg-5.justify-content-center
                        .col-xl-6.col-12.about-container.align-vertically
                            .row.gx-4.gx-lg-5.justify-content-center
                                .col-xl-10.col-12.about-container.align-vertically
                                    h3.mb-4 Please get in touch if you would like to know more about my work, are interested in buying a painting, or exhibiting my work.
                            .row.gx-4.gx-lg-5.justify-content-center
                                .col-md-6.mb-3.mb-md-0
                                    .card.py-4.h-100.bg-white
                                        .card-body.text-center
                                            i.fas.fa-envelope.text-primary.mb-2
                                            h4.text-uppercase.m-0.text-black-50 Email
                                            hr.my-4.mx-auto
                                            p.text-black-50
                                                a(href='mailto:jjkilmory@gmail.com') jjkilmory@gmail.com
                            .social.d-flex.justify-content-center
                                a.mx-5(href='https://www.instagram.com/julesakasarucijackson/')
                                    i.fab.fa-instagram
                            
                        .col-xl-6.col-12.about-container
                            img.img-fluid(src='assets/gallery/contact/01.jpg', alt='...')

        // Footer
        include includes/footer.pug

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js')

        // Core theme JS
        script(src='js/scripts.js')


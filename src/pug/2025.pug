extends layouts/main.pug

block content
    // Section - Canvas
    section.gallery-section
        #canvas
            .container.px-4.px-lg-5

                // Two-column gallery
                .row.gx-0.mb-5.mb-lg-0.justify-content-center
                    +gallery-item('assets/gallery/2025/01.jpg', 'Radiant Field of Love', '80cm x 80cm', 2, true)
                    +gallery-item('assets/gallery/2025/02.jpg', 'Melting my Heart', '80cm x 80cm', 2)
                    +gallery-item('assets/gallery/2025/03.jpg', 'Radiating Warmth', '50cm x 50cm', 2)
                    +gallery-item('assets/gallery/2025/13.jpg', 'Distant Shores', '30cm x 30cm', 2, true)
                    +gallery-item('assets/gallery/2025/06.jpg', 'Calming Mauves', '40cm x 40cm', 2)
                    +gallery-item('assets/gallery/2025/05.jpg', 'Brilliant Rose Dusk', '40cm x 40cm', 2)

                // Full-width gallery
                .row.gx-0.mb-5.mb-lg-0.justify-content-center
                    +gallery-item('assets/gallery/2025/08.jpg', 'The Calm of the Evening', '50cm x 100cm', 1)
                    +gallery-item('assets/gallery/2025/09.jpg', 'Gentle Tide', '50cm x 100cm', 1)
                    +gallery-item('assets/gallery/2025/10.jpg', 'Sky Expansion', '50cm x 100cm', 1)

                // Two-column gallery
                .row.gx-0.mb-5.mb-lg-0.justify-content-center
                    +gallery-item('assets/gallery/2025/12.jpg', 'Burning Eventide', '30cm x 30cm', 2)
                    +gallery-item('assets/gallery/2025/04.jpg', 'The Power of Love', '80cm x 80cm', 2)
                    +gallery-item('assets/gallery/2025/14.jpg', 'Old Madder Isles', '30cm x 30cm', 2)
                    +gallery-item('assets/gallery/2025/15.jpg', 'Fiery Light over The Sound', '30cm x 30cm', 2)
                    +gallery-item('assets/gallery/2025/07.jpg', 'Uplifting Evening Clouds', '60cm x 80cm', 2)
                    +gallery-item('assets/gallery/2025/11.jpg', 'The Horizon is Alight', '70cm x 90cm', 2)
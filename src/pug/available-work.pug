
extends includes/main.pug

block content
    section.gallery-section
        #canvas
            .gallery-scroll

                // Available work: intro and two rows of paintings
                .gallery-slide.available-work-slide
                    .container-fluid.px-4.px-lg-5
                        .row.justify-content-center
                            .col-12
                                .gallery-intro
                                    h4
                                        | These paintings are being shown in the Winter Exhibition at the 
                                        a(href='https://www.strathearn-gallery.com/exhibition/79531/2026-winter-mixed-exhibition') Strathearn Gallery.
                                    h4
                                        | Please 
                                        a(href='https://strathearn-gallery.com/contact') contact
                                        |  the gallery for more details.

                        // First row
                        .row.gx-0.justify-content-center
                            +gallery-item('assets/gallery/available-work/01.jpg', 'Blue Sound of Jura Study 1', '12cm x 12cm', 4)
                            +gallery-item('assets/gallery/available-work/02.jpg', 'Blue Sound of Jura Study 2', '12cm x 12cm', 4)
                            +gallery-item('assets/gallery/available-work/03.jpg', 'Blue Sound of Jura Study 3', '12cm x 12cm', 4)
                            +gallery-item('assets/gallery/available-work/04.jpg', 'Blue Sound of Jura Study 4', '12cm x 12cm', 4)

                        // Second row
                        .row.gx-0.justify-content-center
                            +gallery-item('assets/gallery/available-work/05.jpg', 'Gentle Cloud', '30cm x 30cm', 4)
                            +gallery-item('assets/gallery/available-work/06.jpg', 'Love in the Mist', '30cm x 30cm', 4)
                            +gallery-item('assets/gallery/available-work/07.jpg', 'Textured Clouds', '30cm x 30cm', 4)
                            +gallery-item('assets/gallery/available-work/08.jpg', 'Wide Horizon', '30cm x 30cm', 4)
extends layouts/main.pug

block navbar
    +navbar(true)

block content

    header.masthead
        .container.px-4.px-lg-5.d-flex.h-100.align-items-center.justify-content-center
            .d-flex.justify-content-center
                .text-center
                    h1.mx-auto.my-0.text-uppercase Jules Jackson
                    h2.mx-auto.mt-3.mb-6 The Sky, the Sea, and the Land in between
                        

    // Section - Year Cards
    section.gallery-section
        #canvas
            .container.px-4.px-lg-5
                .row.gx-0.mb-5.mb-lg-0
                    .col-md-4.col-12.gallery-container
                        a.year-card-container(href='/2025.html')
                            img.year-card-image.img-fluid(src='assets/gallery/2025/15.jpg', alt='...')
                            .year-card-text 2025
                    .col-md-4.col-12.gallery-container
                        a.year-card-container(href='/2024.html')
                            img.year-card-image.img-fluid(src='assets/gallery/2024/01.jpg', alt='...')
                            .year-card-text 2024
                    .col-md-4.col-12.gallery-container
                        a.year-card-container(href='/2023.html')
                            img.year-card-image.img-fluid(src='assets/gallery/2023/01.jpg', alt='...')
                            .year-card-text 2023
extends includes/main.pug

block navbar
    +navbar(true)

block content

    header.masthead
        .container.px-4.px-lg-5.d-flex.h-100.align-items-center.justify-content-center
            .d-flex.justify-content-center
                .text-center
                    h1.mx-auto.my-0.text-uppercase Jules Jackson
                    h2.mx-auto.mt-3.mb-6 The Sky, the Sea, and the Land in between
                        

    // Section - Index Cards
    section.index-section
        #canvas
            .container.px-4.px-lg-5
                .row.gx-0.mb-5.mb-lg-0

                    .col-4.gallery-container
                        a.index-card-container(href='/available-work.html')
                            img.index-card-image.img-fluid(src='assets/gallery/2024/10.jpg', alt='Available Work')
                            .index-card-overlay.index-card-overlay-1
                            .index-card-text Available Work

                    .col-4.gallery-container
                        a.index-card-container(href='/current-exhibitions.html')
                            img.index-card-image.img-fluid(src='assets/gallery/2026/04.jpg', alt='Current Exhibitions')
                            .index-card-overlay.index-card-overlay-2
                            .index-card-text Current Exhibitions

                    .col-4.gallery-container
                        a.index-card-container(href='/contact.html')
                            img.index-card-image.img-fluid(src='assets/gallery/2023/01.jpg', alt='Contact Information')
                            .index-card-overlay.index-card-overlay-3
                            .index-card-text Contact Information
mixin gallery-item(src, title, description, columns=3)
    -
        const columnClasses = {
            4: 'col-xl-3 col-md-6 col-6',
            3: 'col-xl-4 col-md-6 col-12',
            2: 'col-md-6 col-12',
            1: 'col-12'
        };
        const columnClass = columnClasses[columns] || columnClasses[3];

    div(class=`${columnClass} gallery-container`)
        img.img-fluid(src=src, alt=title)
        .container
            .row
                .col-10.offset-1
                    p.image-title= title
                    p.image-description= description
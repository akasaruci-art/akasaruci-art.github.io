
extends includes/main.pug

block content
    section.gallery-section
        #canvas
            .gallery-scroll

                // Full-width painting
                .gallery-slide
                    .container-fluid.px-4.px-lg-5
                        .row.gx-0.justify-content-center
                            +gallery-item('assets/gallery/2026/01.jpg', 'Burning Passion', '40cm x 80cm', 1)

                // Two paintings per row
                .gallery-slide
                    .container-fluid.px-4.px-lg-5
                        .row.gx-0.justify-content-center
                            +gallery-item('assets/gallery/2026/02.jpg', 'Radiant Field of Love', '50cm x 50cm', 2)
                            +gallery-item('assets/gallery/2026/03.jpg', 'Floating on the Pink Cloud', '50cm x 50cm', 2)

                // Full-width painting
                .gallery-slide
                    .container-fluid.px-4.px-lg-5
                        .row.gx-0.justify-content-center
                            +gallery-item('assets/gallery/2026/04.jpg', 'Echoes of Cobalt Violet', '50cm x 50cm', 1)

                // Two paintings per row
                .gallery-slide
                    .container-fluid.px-4.px-lg-5
                        .row.gx-0.justify-content-center
                            +gallery-item('assets/gallery/2026/05.jpg', 'Glorious Truth', '50cm x 70cm', 2)
                            +gallery-item('assets/gallery/2026/06.jpg', 'Let Go into the Light', '50cm x 70cm', 2)

                // Final full-width painting
                .gallery-slide
                    .container-fluid.px-4.px-lg-5
                        .row.gx-0.justify-content-center
                            +gallery-item('assets/gallery/2026/07.jpg', 'The Gloaming', '60cm x 60cm', 1)

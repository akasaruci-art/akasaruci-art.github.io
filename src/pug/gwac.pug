extends includes/main.pug
block content

    // Contact
    section.contact-section.extra-about-padding
        .inner-section
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5.justify-content-center 
                    .col-xl-6.col-12.about-container
                        img.img-fluid(src='assets/gallery/gwac/02.jpg', alt='GWAC Postart 2026')
                    .col-xl-6.col-12.about-container.align-vertically
                        h3.mb-4 Glasgow Women's Art Collective
                        p Glasgow Women's Art Collective is a group of women who love art and love making art. The group meets on a regular basis and supports one another in our creative pursuits.
                        p Our next exhibition is at the New Glasgow Society Gallery, 1307 Argyle Street, Glasgow, G3 8TL, from Friday 27th November to Sunday 29th November. We would love you to come and see our work. 
                        p Find out more on Instagram: 
                        a.about-link(href='https://www.instagram.com/glasgowwomensartcollective/') #[i.fab.fa-instagram] Glasgow Women's Art Collective
                .row.gx-4.gx-lg-5
                    .col-xl-6.col-12.about-container
                        img.img-fluid(src='assets/gallery/gwac/01.jpg', alt='GWAC Postart 2025')
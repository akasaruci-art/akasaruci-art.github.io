extends layouts/main.pug
block content
        
    // Contact
    section.contact-section.extra-about-padding.grey-background.text-center
        .inner-section
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5.justify-content-center 
                    .col-xl-6.col-12.about-container
                        img.img-fluid(src='assets/gallery/gwac/01.jpg', alt='...')
                    .col-xl-6.col-12.about-container.align-vertically
                        h3.mb-4 Glasgow Women's Art Collective
                        p Glasgow Women's Art Collective was initiated by the artist Pascale Steenkiste. She came up with the idea of getting a group of women together who loved art and also created their own art.
                        p The group meets on a regular basis and supports one another in our creative pursuits.
                        p We are exhibiting our work together for the first time at the New Glasgow Society, 1307 Argyle Street, Glasgow, G3 8TL, from 9th May to 11th May 2025. We would love you to come and see our work.
                        p Find out more on Instagram: 
                        a.about-link(href='https://www.instagram.com/glasgowwomensartcollective/') #[i.fab.fa-instagram] Glasgow Women's Art Collective